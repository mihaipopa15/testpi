import torch
import torch.nn as nn
import torch.optim as optim
import torchvision
import torchvision.transforms as transforms
from torch.utils.data import DataLoader, random_split
import matplotlib.pyplot as plt

# Setează device-ul
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
torch.manual_seed(42)

# ==========================================
# 1. Definirea Arhitecturii (ConvBlock + Model)
# ==========================================
class ConvBlock(nn.Module):
    def __init__(self):
        super(ConvBlock, self).__init__()
        # Ramura 1 (Stânga)
        self.branch1_avgpool = nn.AvgPool2d(kernel_size=2, stride=16)
        self.branch1_conv = nn.Conv2d(3, 32, kernel_size=1)
        self.branch1_bn = nn.BatchNorm2d(32)
        self.branch1_relu = nn.ReLU()

        # Ramura 2 (Mijloc)
        self.branch2_conv = nn.Conv2d(3, 32, kernel_size=1, stride=16)
        self.branch2_bn = nn.BatchNorm2d(32)
        self.branch2_relu = nn.ReLU()
        
        # Ramura 3 (Dreapta) - Sub-ramura 3.1
        self.branch3_conv1 = nn.Conv2d(3, 64, kernel_size=1)
        self.branch3_relu1 = nn.ReLU()
        
        self.branch3_sub1_conv = nn.Conv2d(64, 32, kernel_size=(1, 3), stride=16, padding=(0, 1))
        self.branch3_sub1_relu = nn.ReLU()
        
        # Ramura 3 (Dreapta) - Sub-ramura 3.2
        self.branch3_sub2_conv = nn.Conv2d(64, 32, kernel_size=(3, 1), stride=16, padding=(1, 0))
        self.branch3_sub2_relu = nn.ReLU()

    def forward(self, x):
        # Ramura 1
        out1 = self.branch1_avgpool(x)
        out1 = self.branch1_conv(out1)
        out1 = self.branch1_bn(out1)
        out1 = self.branch1_relu(out1)
        
        # Ramura 2
        out2 = self.branch2_conv(x)
        out2 = self.branch2_bn(out2)
        out2 = self.branch2_relu(out2)
        
        # Ramura 3
        out3_base = self.branch3_conv1(x)
        out3_base = self.branch3_relu1(out3_base)
        
        out3_1 = self.branch3_sub1_conv(out3_base)
        out3_1 = self.branch3_sub1_relu(out3_1)
        
        out3_2 = self.branch3_sub2_conv(out3_base)
        out3_2 = self.branch3_sub2_relu(out3_2)
        
        # Concatenare pe axa canalelor (dim=1)
        # 32 + 32 + 32 + 32 = 128 canale
        out = torch.cat([out1, out2, out3_1, out3_2], dim=1)
        return out

class CustomCNN(nn.Module):
    def __init__(self):
        super(CustomCNN, self).__init__()
        self.conv_block = ConvBlock()
        self.flatten = nn.Flatten()
        # După convoluțiile cu stride 16 dintr-o imagine 32x32, 
        # dimensiunea spațială devine 2x2. 
        # Avem 128 canale concatinate * 2 * 2 = 512.
        self.linear = nn.Linear(128 * 2 * 2, 100)

    def forward(self, x, print_shapes=False):
        x = self.conv_block(x)
        if print_shapes: print(f"ConvBlock output shape:   {x.shape}")
        
        x = self.flatten(x)
        if print_shapes: print(f"Flatten output shape:     {x.shape}")
        
        x = self.linear(x)
        if print_shapes: print(f"Linear output shape:      {x.shape}")
        
        return x

# ==========================================
# 2. Afișarea dimensiunilor (Dummy Pass)
# ==========================================
dummy_model = CustomCNN()
dummy_input = torch.randn(1, 3, 32, 32)
# Rulăm un batch de 1 imagine prin rețea pentru a printa exact formele cerute
print("--- Formele outputurilor ---")
_ = dummy_model(dummy_input, print_shapes=True)
print("-" * 28)

# ==========================================
# 3. Pregătirea Datelor
# ==========================================
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))
])

full_train_dataset = torchvision.datasets.CIFAR100(root='./data', train=True, download=True, transform=transform)

# Împărțire: 6000 antrenare, restul (44000) validare, conform imaginii
train_dataset, val_dataset = random_split(full_train_dataset, [6000, 44000])
test_dataset = torchvision.datasets.CIFAR100(root='./data', train=False, download=True, transform=transform)

batch_size = 256
train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True, num_workers=2)
val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False, num_workers=2)
test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False, num_workers=2)

# ==========================================
# 4. Setări Antrenare
# ==========================================
model = CustomCNN().to(device)
epochs = 5
learning_rate = 0.05

criterion = nn.CrossEntropyLoss()
optimizer = optim.SGD(model.parameters(), lr=learning_rate)

train_accuracies = []
val_accuracies = []

# ==========================================
# 5. Bucla de Antrenare
# ==========================================
print("\nÎncepe antrenarea...")
for epoch in range(epochs):
    model.train()
    correct_train, total_train = 0, 0
    
    for inputs, labels in train_loader:
        inputs, labels = inputs.to(device), labels.to(device)
        
        optimizer.zero_grad()
        outputs = model(inputs)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()
        
        _, predicted = torch.max(outputs.data, 1)
        total_train += labels.size(0)
        correct_train += (predicted == labels).sum().item()
        
    train_acc = 100 * correct_train / total_train
    train_accuracies.append(train_acc)
    
    # Evaluare pe validare
    model.eval()
    correct_val, total_val = 0, 0
    with torch.no_grad():
        for inputs, labels in val_loader:
            inputs, labels = inputs.to(device), labels.to(device)
            outputs = model(inputs)
            _, predicted = torch.max(outputs.data, 1)
            total_val += labels.size(0)
            correct_val += (predicted == labels).sum().item()
            
    val_acc = 100 * correct_val / total_val
    val_accuracies.append(val_acc)
    print(f"Epoch {epoch+1}/{epochs} | Train Acc: {train_acc:.2f}% | Val Acc: {val_acc:.2f}%")

# ==========================================
# 6. Plotarea Acurateții
# ==========================================
plt
